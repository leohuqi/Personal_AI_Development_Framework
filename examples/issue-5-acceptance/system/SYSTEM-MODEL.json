      "LedgerDomain"
    ],
    "BillImport": [
      "LedgerApplication",
      "LedgerDomain"
    ],
    "CategoryRules": [
      "LedgerApplication",
      "LedgerDomain"
    ],
    "LocationAccess": [
      "LedgerApplication",
      "LedgerDomain"
    ],
    "BackupArchive": [
      "LedgerApplication",
      "LedgerDomain"
    ],
    "App": [
      "LedgerPresentation",
      "LedgerPersistence",
      "BillImport",
      "CategoryRules",
      "LocationAccess",
      "BackupArchive"
    ]
  }
