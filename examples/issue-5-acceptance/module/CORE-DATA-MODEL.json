  "relationship_notation": "[leftEntity,leftProperty,rightEntity,inverseProperty,leftMultiplicityPerRight,rightMultiplicityPerLeft]",
  "delete_rules": "Deny for all to-many ownership/referenced edges; Nullify only optional selectedLocation/effectiveOverride pointers. No hard-delete command in module v1. Explicit store replacement only under maintenance. All inverses explicit.",
  "invariants": [
    "Scalar UUID FKs agree with relationship destination; validate on writer and restore",
    "Every SourceIdentity has one Entry and >=1 SourceObservation; manual Entry has none",
    "SourceObservation always has one BatchReceipt, AccountNamespace and Entry; identity optional for no-ID",
    "RefundLink.original/refund are different Entry instances with spend/refund kinds and same currency; refund amount negative, original positive; aggregate cap enforced in writer",
    "Every Entry has one Category, selectedLocation/effectiveOverride must belong to same Entry",
    "No managed-object validation can replace aggregate transaction checks",
    "StoreMetadata singleton and key presence required before reads/writes"
  ],
  "storage_rules": [
    "No transformable or insecure unarchive; binary arrays decoded data-only with quotas",
    "No raw provider ID/account credentials/raw file/filename/path persisted",
    "HMAC bytes and file hashes are sensitive protected evidence; no logs",
    "Core Data uniqueness/index descriptions are logical design; generated xcdatamodel and migration/build NOT_RUN",
    "BinaryData hashes fixed 32 bytes validated by writer; Integer64 revision checked <=Int64.max",
    "All non-optional fields required unless explicitly optional; defaults supplied by writer, not guessed by migration"
  ]
