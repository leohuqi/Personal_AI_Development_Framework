{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:padf:engineering:testing-architecture:v1",
  "title": "Testing Architecture & Quality Strategy",
  "type": "object",
  "properties": {
    "schema_version": {"const": "padf.testing-architecture/v1"},
    "context_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "source_ref": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["revision"],
      "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
    },
    "status": {"enum": ["PROPOSED", "APPROVED"]},
    "approval_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["revision"],
          "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
        },
        {"type": "null"}
      ]
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "basis_ref": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "required": ["revision"],
            "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
          }
        },
        "required": ["name", "version", "basis_ref"]
      },
      "minItems": 1
    },
    "profile": {"enum": ["Lite", "Standard", "Full"]},
    "test_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1},
    "test_layers": {
      "type": "array",
      "items": {"enum": ["unit", "component", "api", "integration", "e2e"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "real_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "mock_boundary": {"type": "string", "minLength": 1},
          "isolation": {"type": "string", "minLength": 1}
        },
        "required": ["subject", "real_dependencies", "mock_boundary", "isolation"]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "purpose": {"type": "string", "minLength": 1}
        },
        "required": ["id", "argv", "purpose"]
      }
    },
    "ci_ref": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["revision"],
          "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
        }
      ]
    },
    "coverage_policy": {
      "type": "object",
      "properties": {
        "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "include": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "denominator": {"type": "string", "minLength": 1},
        "risk_basis": {"type": "string", "minLength": 1}
      },
      "required": ["metrics", "include", "exclude", "denominator", "risk_basis"]
    },
    "reporting": {"type": ["string", "object"]},
    "tdd_scope": {"type": ["string", "object", "array"]},
    "data_privacy": {"type": ["string", "object"]}
  },
  "required": [
    "schema_version",
    "context_id",
    "strategy_id",
    "project",
    "source_ref",
    "status",
    "approval_ref",
    "stack",
    "profile",
    "test_types",
    "test_layers",
    "boundaries",
    "commands",
    "ci_ref",
    "coverage_policy",
    "reporting",
    "tdd_scope",
    "data_privacy"
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}},
      "then": {
        "properties": {
          "approval_ref": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "required": ["revision"],
            "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
          }
        }
      }
    }
  ]
}
